{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": [],
  "overrides": [
    { "files": ["*.ts", "*.tsx"], "options": { "parser": "typescript" } },
    { "files": ["*.json"], "options": { "parser": "json" } },
    { "files": ["*.md"], "options": { "parser": "markdown", "proseWrap": "always" } }
  ]
}
