# ─── Environment Configuration ────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/saar_dev?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_BYTE_HEX
JWT_ACCESS_EXPIRES_IN=900      # 15 minutes in seconds
JWT_REFRESH_EXPIRES_IN=2592000 # 30 days in seconds

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000   # 1 minute window in ms
THROTTLE_LIMIT=100   # max requests per window per IP

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug   # debug | info | warn | error

# ── Object Storage (S3-compatible) ────────────────────────────────────────────
# Not required for Phase 1 — stub values
OBJECT_STORAGE_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
OBJECT_STORAGE_BUCKET=REPLACE_WITH_BUCKET_NAME
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_SECRET_KEY
OBJECT_STORAGE_REGION=ap-south-1

# ── AI Provider (Phase 6 — stub for now) ──────────────────────────────────────
AI_PROVIDER_API_KEY=REPLACE_WHEN_NEEDED
AI_PROVIDER_BASE_URL=REPLACE_WHEN_NEEDED

# ── Email Provider (Phase stub) ───────────────────────────────────────────────
EMAIL_PROVIDER_API_KEY=REPLACE_WHEN_NEEDED
EMAIL_FROM_ADDRESS=noreply@saar.app

# ── Push Notifications (Phase stub) ───────────────────────────────────────────
PUSH_PROVIDER_KEY=REPLACE_WHEN_NEEDED

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=saar-api
OTEL_EXPORTER_OTLP_ENDPOINT=REPLACE_WHEN_NEEDED
# SENTRY_DSN=REPLACE_WHEN_NEEDED

# ── Billing (Phase 7 — stub) ──────────────────────────────────────────────────
# BILLING_PROVIDER_SECRET=REPLACE_WHEN_NEEDED
# BILLING_WEBHOOK_SECRET=REPLACE_WHEN_NEEDED
